# Sanity Configuration
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_TOKEN=your_api_token
VITE_SANITY_API_VERSION=2023-05-03

# Optional: CDN configuration
VITE_SANITY_USE_CDN=true

# Base URL for your Sanity Studio (if applicable)
VITE_SANITY_STUDIO_URL=http://localhost:3333

# Portfolio bot backend endpoint (FastAPI on Render).
# Falls back to http://127.0.0.1:8000/chat in dev when unset.
VITE_PORTFOLIO_BOT_URL=https://your-service.onrender.com/chat
